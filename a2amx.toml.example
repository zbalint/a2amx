# Copy to a2amx.toml, then run: a2amx team up
# Session names are unique per daemon and shared by every project on the machine,
# so prefix them with the project name (here "myproject-") to avoid collisions.
[[session]]
name = "myproject-architect"
command = ["claude"]
attach = true
# reset = ["/clear"]
# control_from = ["myproject-developer"]
# watch = ["myproject-developer"] # notify this session when the peer exits naturally
# heartbeat = "30m" # digest watched peers after 30 minutes of idle time

[[session]]
name = "myproject-developer"
command = ["omp"]
cwd = "."
