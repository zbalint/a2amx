# Copy to a2amx.toml, then run: a2amx team up
# Session names are unique per daemon and shared by every project on the machine.
# Set a file-level prefix once; the tool adds its dash to these unprefixed names.
prefix = "myproject"
[[session]]
name = "architect"
command = ["claude"]
attach = true
# role = "architect" # optional label shown only to this session
# reset = ["/clear"]
# control_from = ["developer"]
# watch = ["developer"] # notify this session when the peer exits naturally
# heartbeat = "30m" # digest watched peers after 30 minutes of idle time

[[session]]
name = "developer"
command = ["omp"]
role = "developer"
cwd = "."
